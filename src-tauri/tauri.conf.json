{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "narra-notch",
  "version": "2.2.0",
  "identifier": "app.narra-notch.windows",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "notch",
        "create": false,
        "title": "narra-notch",
        "width": 880,
        "height": 620,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2MkEzMjY2NDA0NEMxNTYKUldSV3dVUkFaaklxeHQrNTdWcEFCVXg3ZmFJN3FGM1dpSEU0ZTJKUHFnY3NnVC82S21Ea1hNUisK",
      "endpoints": [
        "https://github.com/carissadarmafissaleha/narra-notch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
